# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables
.env
.env.local
.env.*.local

# Output folder (generated at runtime)
output/
**/output/

# Sample data folder (generated at runtime)
sample_data/
**/sample_data/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Kiro IDE settings (local)
.kiro/settings/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Excel and xlsm files (general - excluded by default)
*.xlsx
*.xlsm
*.xls

# EXCEPTION: rules/ folder — Nancy's source-of-truth Excel files (tracked for team reference)
!rules/*.xlsx
!rules/*.xlsm
!rules/*.xls

# PowerPoint files (generated, not source code)
*.pptx
*.ppt

# Distribution and packaging
dist/
build/
*.egg-info/
*.egg

